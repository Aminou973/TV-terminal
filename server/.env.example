# Copy to .env and adjust. All settings are env vars with prefix OPENTERM_
OPENTERM_JWT_SECRET=change-me-to-a-long-random-string
OPENTERM_DATA_DIR=../data

# ingest providers
OPENTERM_REPLAY_ENABLED=true
OPENTERM_NINJA_ENABLED=true
OPENTERM_NINJA_TCP_HOST=127.0.0.1
OPENTERM_NINJA_TCP_PORT=5555
OPENTERM_CCXT_ENABLED=true
OPENTERM_CCXT_EXCHANGE=binance
OPENTERM_CCXT_SYMBOLS=["BTC/USDT","ETH/USDT"]
# stocks / ETFs / indices / futures / FX via yfinance (Yahoo naming: AAPL, ^GSPC, ES=F, EURUSD=X)
OPENTERM_YF_ENABLED=true
OPENTERM_YF_TICKERS=["AAPL","MSFT","NVDA","TSLA","SPY","QQQ","ES=F","NQ=F","GC=F","EURUSD=X"]
OPENTERM_YF_POLL_S=15

# alert delivery (each user sets their own webhook / Telegram chat / email under Alerts → ⚙)
OPENTERM_SMTP_HOST=
OPENTERM_SMTP_PORT=587
OPENTERM_SMTP_USER=
OPENTERM_SMTP_PASSWORD=
OPENTERM_SMTP_FROM=
OPENTERM_SMTP_TLS=true
# shared bot used when a user only gives a chat id
OPENTERM_TELEGRAM_BOT_TOKEN=
# webhooks to localhost / LAN are refused unless this is on (SSRF guard)
OPENTERM_ALERTS_ALLOW_PRIVATE_WEBHOOKS=false
